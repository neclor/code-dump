BOILER2_CHEST = Position(x=-19.5, y=32.5)
def feed_boiler_chest(reserve=250):
    spare = inv(Prototype.Coal) - reserve
    if spare <= 0:
        return
    for pos, proto in ((BOILER_CHEST, Prototype.WoodenChest), (BOILER2_CHEST, Prototype.IronChest)):
        move_to(Position(x=pos.x + 2, y=pos.y + 2))
        try:
            insert_item(Prototype.Coal, get_entity(proto, pos), quantity=max(1, spare // 2))
        except Exception as e:
            pass
def cycle(pk=80, gr=50):
    for _ in range(4):
        sleep(15)
    collect_coal(); collect_plates(); refuel(top_up=15); feed_boiler_chest()
    stash(Prototype.CopperPlate, 500); stash(Prototype.IronGearWheel, 100)
    feed_packs(pk); feed_green(gr)
    r = ensure_research()
    i = inspect_inventory()
    print('iron', i[Prototype.IronPlate], 'cu', i[Prototype.CopperPlate], 'coal', i[Prototype.Coal], 'research', r)
for _ in range(2):
    cycle()

